@using WebMatrix.Data;
@{
    ViewBag.Title = "Create";
    var db = Database.Open("GameDB");
    var familysql = "select FamilyCode, FamilyCode + ' - ' + Family as Family from GameFamily";
    var familydata = db.Query(familysql);
    var idsql = "select Max(BGGId) from BoardGame";
    var lastid = db.QueryValue(idsql);
    var newid = lastid + 1;
    if (IsPost)
    {
        var addsql = "insert into BoardGame(BGGId,Name, Description, Family) values(@0,@1,@2,@3)";
        var data = db.Execute(addsql,newid, Request.Form["GameName"], Request.Form["GameDescription"], Request.Form["family"]);
    }

}
<div class="bg-light py-1 mt-2">
    <h2 class="text-center">Add new Game</h2>
</div>

<form method="post" action="/Home/Create">
    <label for="GameName">Name</label><br />
    <input type="text" name="GameName" class="form-control" placeholder="Game Name..." />
    <label for="GameDescription">Description</label><br />
    <input type="text" name="GameDescription" class="form-control" placeholder="Description..." />
    <label for="Category">Category</label><br />
    <select class="form-select" aria-label="Default select example" name="family">
        <option selected>Categories</option>
        @foreach (var row in familydata)
        {
            <option value="@row.FamilyCode">@row.Family</option>
        }
    </select>
    <div class="text-center mt-3">
        <button type="submit" class="btn btn-success">Save</button>
        <button type="reset" class="btn btn-danger">Clear</button>
    </div>
</form>
