
@using WebMatrix.Data;

@{
    ViewBag.Title = "Edit";
    var db = Database.Open("GameDB");
    var sql = "select * from BoardGame " +
              "where BoardGame.BGGId = @0";
    var id = Request.QueryString["id"];
    var data = db.QuerySingle(sql, id);
    var testname = Request.Form["Name"];
    var testdescription = Request.Form["Description"];
    if (IsPost)
    {
        var editsql = "Update BoardGame set name = @0, Description = @1 where BGGId = @2";
        var editData = db.Execute(editsql, Request.Form["Name"], Request.Form["Description"], Request.QueryString["id"]);

    }
    }
<head>
    <link rel="stylesheet" type="text/css" href="/Content/Site.css" />
</head>
<div class="bg-light py-1 mt-2">
    <h2 class="text-center">BoardGame Edit</h2>
</div>

<form method="post" action="/Home/Edit?id=@(id)">
    <label for="Name">Name</label><br />
